PORT=3000
NODE_ENV=development

# BTP OAuth — client credentials grant
BTP_TOKEN_URL=https://ec-demo.authentication.eu10.hana.ondemand.com/oauth/token
BTP_CLIENT_ID=your-client-id
BTP_CLIENT_SECRET=your-client-secret

# CF API (for creating HDSF instances programmatically)
