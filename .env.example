# HDSF base URL (once you have an instance)
HDSF_BASE_URL=https://your-hdsf-instance.cfapps.eu10.hana.ondemand.com/fhir/R4

# S/4HANA Cloud
S4_TENANT_URL=https://my-s4hana.ondemand.com
